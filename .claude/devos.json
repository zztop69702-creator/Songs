{
  "_설명": "운영체계 훅 설정. checkExtensions: 수정 직후 문법 검사할 확장자. protectedFiles: 바뀌면 알리는 중요 파일(경로에 포함되면 해당). stopTests: 작업 종료 시, 바뀐 파일 경로가 when 으로 시작하면 run 을 한 번 실행(같은 내용이면 다시 안 돌림). {tmp} 는 임시 폴더로 바뀐다.",
  "checkExtensions": [".js", ".mjs", ".cjs", ".html", ".htm", ".json", ".py"],
  "protectedFiles": ["CLAUDE.md", ".claude/settings.json", ".claude/devos.json", "ai-next-step/build.py", "ai-next-step/src/install.ps1", "package.json"],
  "stopTests": [
    {
      "when": "ai-next-step/src/",
      "name": "경험곱하기AI 빠른 흐름 검사(1~10단계, PC·휴대폰)",
      "run": "node .claude/skills/experience-ai-release/scripts/smoke.js ai-next-step/src/app.html {tmp}/smoke",
      "failPattern": "ERRORS: \\[(?!\\])|PAGEERROR|TimeoutError",
      "timeoutSec": 150
    }
  ]
}
